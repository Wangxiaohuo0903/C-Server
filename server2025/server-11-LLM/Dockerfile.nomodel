# Server-11 真实AI推理 Dockerfile (不下载模型版本 - 快速测试)
# 编译llama.cpp + Server-11

FROM ubuntu:22.04

# 设置非交互模式
ENV DEBIAN_FRONTEND=noninteractive

# 安装构建工具和依赖
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    git \
    wget \
    curl \
    libsqlite3-dev \
    && rm -rf /var/lib/apt/lists/*

# 创建工作目录
WORKDIR /app

# 复制third_party目录（包含llama.cpp）
COPY third_party/ /app/third_party/

# 编译llama.cpp
WORKDIR /app/third_party/llama.cpp
RUN echo "Building llama.cpp..." && \
    mkdir -p build && cd build && \
    cmake .. -DCMAKE_BUILD_TYPE=Release -DLLAMA_CURL=OFF && \
    cmake --build . --config Release -j4 && \
    echo "llama.cpp build completed!" && \
    echo "Library files:" && \
    find . -name "*.so" -o -name "*.a" 2>/dev/null | head -20

# 复制Server-11源代码
WORKDIR /app
COPY *.h /app/
COPY *.cpp /app/
COPY README.md /app/

# 编译Server-11
RUN echo "Building Server-11..." && \
    g++ main.cpp -o server11 \
    -I/app/third_party/llama.cpp/include \
    -I/app/third_party/llama.cpp/ggml/include \
    -I/app/third_party/llama.cpp/common \
    -L/app/third_party/llama.cpp/build/bin \
    -lllama \
    -lggml \
    -lsqlite3 \
    -lpthread \
    -std=c++11 \
    && echo "Server-11 build completed!" && \
    ls -lh server11

# 创建模型目录
RUN mkdir -p /app/models

# 设置环境变量
ENV MODEL_PATH=/app/models/tinyllama-q4.gguf
ENV LD_LIBRARY_PATH=/app/third_party/llama.cpp/build/bin:${LD_LIBRARY_PATH}

# 暴露端口
EXPOSE 8080

# 启动命令
CMD echo "==================================" && \
    echo "Server-11 with Real AI (No Model)" && \
    echo "==================================" && \
    echo "" && \
    echo "⚠️  模型未下载！" && \
    echo "请使用以下方式之一提供模型：" && \
    echo "" && \
    echo "方式1: 挂载本地模型目录" && \
    echo "  docker run -v ./models:/app/models ..." && \
    echo "" && \
    echo "方式2: 进入容器手动下载" && \
    echo "  docker exec -it server11-real-ai bash" && \
    echo "  cd /app && ./download_model.sh" && \
    echo "" && \
    echo "当前状态: 等待模型文件..." && \
    sleep 5 && \
    ./server11
