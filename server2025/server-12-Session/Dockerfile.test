# Server-12 轻量级测试镜像（不包含llama.cpp，用于快速测试API）
FROM ubuntu:22.04

WORKDIR /app

# 安装最小依赖
RUN apt-get update && apt-get install -y \
    g++ \
    libsqlite3-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 创建模拟的llama.cpp头文件（用于编译）
RUN mkdir -p /llama.cpp && cat > /llama.cpp/llama.h << 'LLAMA_EOF'
#pragma once
#include <string>
#include <vector>
#include <cstdint>

typedef int32_t llama_token;
struct llama_model {};
struct llama_context {};
struct llama_vocab {};
struct llama_model_params {};
struct llama_context_params { int n_ctx; int n_threads; int n_batch; };
struct llama_batch { 
    llama_token* token; int* pos; int** seq_id; int* n_seq_id; int8_t* logits; int n_tokens;
};

inline llama_model_params llama_model_default_params() { return {}; }
inline llama_context_params llama_context_default_params() { return {}; }
inline llama_model* llama_load_model_from_file(const char*, llama_model_params) { return nullptr; }
inline void llama_free_model(llama_model*) {}
inline void llama_free(llama_context*) {}
inline llama_context* llama_new_context_with_model(llama_model*, llama_context_params) { return nullptr; }
inline const llama_vocab* llama_model_get_vocab(llama_model*) { return nullptr; }
inline int llama_tokenize(const llama_vocab*, const char*, int, llama_token*, int, bool, bool) { return -1; }
inline int llama_decode(llama_context*, llama_batch) { return -1; }
inline llama_batch llama_batch_init(int, int, int) { return {}; }
inline void llama_batch_free(llama_batch) {}
inline int llama_get_kv_cache_used_cells(llama_context*) { return 0; }
inline const float* llama_get_logits(llama_context*) { return nullptr; }
inline int llama_vocab_eos(const llama_vocab*) { return 0; }
inline int llama_vocab_n_tokens(const llama_vocab*) { return 1000; }
inline int llama_token_to_piece(const llama_vocab*, llama_token, char*, int, int, bool) { return 0; }
LLAMA_EOF

# 复制源代码
COPY *.h *.cpp /app/

# 编译Server-12（使用模拟的llama.cpp）
RUN g++ /app/main.cpp -o /app/server12 \
    -I/llama.cpp \
    -lsqlite3 \
    -lpthread \
    -std=c++11

# 暴露端口
EXPOSE 8080

# 启动命令
CMD ["/app/server12"]
